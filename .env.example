# ── Exness API ────────────────────────────────────────────────────────────────
EXNESS_API_KEY=exnsk-your-api-key
EXNESS_PRIVATE_KEY=your-private-signing-key
EXNESS_ACCOUNT_ID=123456789
EXNESS_DISCOVERY_URL=https://api.exness.com
# EXNESS_ACCESS_POINT=https://ap-xxxxxxxx.exness.com

# ── Loop ─────────────────────────────────────────────────────────────────────
AGENT_SCAN_INTERVAL_MS=2000
AGENT_ALIGN_SCAN_TO_CANDLE=false
AGENT_MANAGE_INTERVAL_MS=1000
AGENT_SCREENER_TF=M1
AGENT_TREND_TF=M5
AGENT_CONFIRM_TF=M1
AGENT_TRAIL_TF=M1

# ── Sizing ───────────────────────────────────────────────────────────────────
EXNESS_VIRTUAL_EQUITY=10000
AGENT_RISK_PCT=0.1
AGENT_MAX_OPEN_RISK_PCT=2
AGENT_MAX_DAILY_LOSS_PCT=3
AGENT_MARGIN_RESERVE_PCT=25
AGENT_MARGIN_BUFFER=3
AGENT_MAX_LOTS=0.5

# ── Broker emergency SL (jaring pengaman, bukan TS utama) ────────────────────
AGENT_EMERGENCY_SL_ATR=1.5
AGENT_MIN_STOP_PIPS=6
AGENT_STOP_RETRY_MS=15000

# ── TS pre-lock (jarak lebar sebelum profit) ──────────────────────────────────
AGENT_TRAIL_ATR=1.2
AGENT_TRAIL_ATR_PERIOD=14
AGENT_TRAIL_MIN_PIPS=4

# ── TS post-lock (yang Anda minta: cepat ngejar profit) ──────────────────────
# Lock pertama aktif saat executable price ≥ entry + (spread + buffer).
# Buffer kecil → lock lebih awal. 0.3 = agresif, 1.0 = konservatif.
AGENT_PROFIT_LOCK_MIN_PIPS=0.3

# Faktor DASAR jarak trail setelah lock. Ini yang dikalikan progresif:
#   profit 0 ATR → × 1.00
#   profit 1 ATR → × 0.60
#   profit 2+ ATR → × 0.30
# Contoh: base 0.35 → efektif 0.35 / 0.21 / 0.105 × ATR.
AGENT_PROFIT_TRAIL_ATR=0.35

# Floor jarak pasca-lock. Jarak efektif = max(base×ATR×shrink, minPips, spread×1.1).
AGENT_PROFIT_TRAIL_MIN_PIPS=0.4

# Broker SL ikut mengejar TS lebih cepat (backup kalau koneksi putus).
AGENT_BROKER_STOP_UPDATE_MS=5000
AGENT_BROKER_STOP_MOVE_MIN_PIPS=2

# ── Entry filter ─────────────────────────────────────────────────────────────
AGENT_SHORTLIST=20
AGENT_MAX_CANDIDATES=20
AGENT_MIN_SCORE=10
AGENT_PULLBACK_ATR=3
AGENT_MIN_TREND_ATR=0.003
AGENT_RSI_MIN=20
AGENT_RSI_MAX=80
AGENT_BREAKOUT_LOOKBACK=5
AGENT_BREAKOUT_BODY_ATR=0.08
AGENT_BREAKOUT_RSI_FLOOR=18
AGENT_BREAKOUT_RSI_CEILING=82

# ── Spread filter ────────────────────────────────────────────────────────────
AGENT_MAX_SPREAD_PIPS=5
AGENT_MAX_SPREAD_PCT=0.08
AGENT_MAX_METAL_SPREAD_PCT=0.12
AGENT_MAX_CRYPTO_SPREAD_PCT=0.2
AGENT_MAX_ENERGY_SPREAD_PCT=0.12
AGENT_MAX_SPREAD_SPIKE_RATIO=2.5
AGENT_MAX_SPREAD_TRAIL=0.4

# ── Volatility & re-entry ────────────────────────────────────────────────────
AGENT_MIN_ATR_PCT=0.0025
AGENT_MAX_ATR_PCT=1.8
AGENT_MAX_CHASE_ATR=1.5
AGENT_MAX_QUOTE_AGE_MS=8000
AGENT_REENTRY_STEP_ATR=0.2
AGENT_REENTRY_MIN_PIPS=1