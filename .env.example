# Exness Trader API credentials (never commit the real .env)
# API key identifier from Key Management
EXNESS_API_KEY=exnsk-your-api-key

# Ed25519 private signing key.
# Accepted formats:
#   1. hex seed (64 chars)
#   2. hex key pair seed||public (128 chars)  <- what Exness Key Management gives you
#   3. PEM PKCS#8 ("-----BEGIN PRIVATE KEY-----")
EXNESS_PRIVATE_KEY=your-private-signing-key

# Trading account selected in Key Management
EXNESS_ACCOUNT_ID=123456789

# Gateway used only for access-point discovery
EXNESS_DISCOVERY_URL=https://api.exness.com

# Optional: pin the account access point and skip discovery
# EXNESS_ACCESS_POINT=https://ap-xxxxxxxx.exness.com

# Agent defaults: M1 screener/confirmation/trail, M15 trend.
# The dashboard and the live agent start together with `npm start`.
# AGENT_SCREENER_TF=M1
# AGENT_TREND_TF=M15
# AGENT_CONFIRM_TF=M1
# AGENT_TRAIL_TF=M1
# Live risk sizing uses the account snapshot. Virtual equity is compatibility-only.
# EXNESS_VIRTUAL_EQUITY=10000
# AGENT_RISK_PCT=0.5
# AGENT_MAX_OPEN_POSITIONS=3
# AGENT_MAX_OPEN_RISK_PCT=2
# AGENT_MAX_DAILY_LOSS_PCT=3
# AGENT_MARGIN_RESERVE_PCT=25
# AGENT_MARGIN_BUFFER=3
# AGENT_EMERGENCY_SL_ATR=1.5
# AGENT_MIN_STOP_PIPS=6
# AGENT_TRAIL_ATR=1.2
# AGENT_TRAIL_MIN_PIPS=4
# TS VIRT dynamically follows the best price by ATR/pip distance; it never backs off.
# AGENT_BROKER_STOP_UPDATE_MS=10000
# AGENT_BROKER_STOP_MOVE_MIN_PIPS=2
# Candidate ranking and entry aggression (does not change per-trade risk):
# AGENT_SHORTLIST=20
# AGENT_MAX_CANDIDATES=16
# AGENT_MIN_SCORE=16
# AGENT_PULLBACK_ATR=2.2
# AGENT_MIN_TREND_ATR=0.006
# AGENT_RSI_MIN=27
# AGENT_RSI_MAX=73
# AGENT_BREAKOUT_LOOKBACK=10
# AGENT_BREAKOUT_BODY_ATR=0.15
# AGENT_BREAKOUT_RSI_FLOOR=18
# AGENT_BREAKOUT_RSI_CEILING=82
# Per-symbol rolling median spike guard; hard spread caps remain active:
# AGENT_MAX_SPREAD_SPIKE_RATIO=2.5
